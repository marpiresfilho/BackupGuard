<UserControl x:Class="BackupGuard.App.Views.JobsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210"/>
            <ColumnDefinition Width="18"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Lista de tarefas -->
        <StackPanel Grid.Column="0">
            <ListBox ItemsSource="{Binding Jobs}" SelectedItem="{Binding Selected}" BorderThickness="0"
                     Background="Transparent" ItemContainerStyle="{StaticResource PlainListItem}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding SourceFolder}" FontSize="10.5" Foreground="{StaticResource TextMuted}"
                                       TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <Button Style="{StaticResource SecondaryButton}" Command="{Binding AddCommand}" Margin="0,4,0,0" HorizontalAlignment="Stretch">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE710;" FontFamily="{StaticResource Icons}" FontSize="11" VerticalAlignment="Center"/>
                    <TextBlock Text="Adicionar tarefa" Margin="7,0,0,0"/>
                </StackPanel>
            </Button>
        </StackPanel>

        <!-- Editor -->
        <TextBlock Grid.Column="2" Text="Adicione uma tarefa para começar." Style="{StaticResource Body}"
                   Visibility="{Binding HasSelection, Converter={StaticResource InverseBoolToVis}}"/>
        <StackPanel Grid.Column="2" DataContext="{Binding Selected}"
                    Visibility="{Binding DataContext.HasSelection, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}">

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="IDENTIFICAÇÃO" Style="{StaticResource SectionLabel}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="180"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Nome" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Código" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding Id, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource Mono}" FontSize="12"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock Style="{StaticResource Hint}"
                               Text="O código entra no nome dos arquivos no Drive (ex.: financeiro_2026-10-25_...). Use letras e números, sem espaços."/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="ORIGEM DOS BACKUPS" Style="{StaticResource SectionLabel}"/>
                    <TextBlock Text="Pasta com os arquivos a proteger" Style="{StaticResource FieldLabel}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding SourceFolder, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource Mono}" FontSize="12"/>
                        <Button Grid.Column="1" Content="Procurar…" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                                Command="{Binding DataContext.BrowseFolderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                    </Grid>
                    <TextBlock Text="⚠ Pasta não encontrada neste computador" Foreground="{StaticResource Danger}" FontSize="11" Margin="0,4,0,0"
                               Visibility="{Binding FolderExists, Converter={StaticResource InverseBoolToVis}}"/>
                    <TextBlock Style="{StaticResource Hint}" Text="Depois de confirmados na nuvem, os arquivos de dentro da pasta são apagados. A pasta continua existindo."/>

                    <CheckBox Content="Incluir subpastas" Style="{StaticResource Switch}" IsChecked="{Binding IncludeSubfolders}" Margin="0,14,0,0"/>

                    <TextBlock Text="Tipos de arquivo" Style="{StaticResource FieldLabel}" Margin="0,14,0,5"/>
                    <TextBox Text="{Binding Patterns, UpdateSourceTrigger=LostFocus}" FontFamily="{StaticResource Mono}" Width="260" HorizontalAlignment="Left"/>
                    <TextBlock Style="{StaticResource Hint}" Text="* = todos. Para filtrar, separe por ponto e vírgula: *.bak; *.fdb"/>

                    <TextBlock Text="AGUARDAR O ARQUIVO PARAR DE MUDAR POR" Style="{StaticResource SectionLabel}" Margin="0,16,0,8"/>
                    <WrapPanel>
                        <RadioButton Style="{StaticResource Pill}" Content="1 min" IsChecked="{Binding StableSeconds, Converter={StaticResource Equals}, ConverterParameter=60}"/>
                        <RadioButton Style="{StaticResource Pill}" Content="2 min" IsChecked="{Binding StableSeconds, Converter={StaticResource Equals}, ConverterParameter=120}"/>
                        <RadioButton Style="{StaticResource Pill}" Content="5 min" IsChecked="{Binding StableSeconds, Converter={StaticResource Equals}, ConverterParameter=300}"/>
                        <RadioButton Style="{StaticResource Pill}" Content="10 min" IsChecked="{Binding StableSeconds, Converter={StaticResource Equals}, ConverterParameter=600}"/>
                    </WrapPanel>
                    <TextBlock Style="{StaticResource Hint}" Text="Evita enviar um arquivo que ainda está sendo gravado."/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="HORÁRIO DO BACKUP" Style="{StaticResource SectionLabel}"/>
                    <CheckBox Content="Avisar se o backup não chegar" Style="{StaticResource Switch}" IsChecked="{Binding AlertEnabled}"/>
                    <TextBlock Style="{StaticResource Hint}" Margin="37,2,0,0"
                               Text="Se nenhum arquivo novo chegar até o horário + tolerância, você recebe um alerta no Telegram."/>
                    <StackPanel IsEnabled="{Binding AlertEnabled}" Margin="0,12,0,0">
                        <TextBlock Text="Horário em que o backup costuma ser gerado" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding ExpectedTime, UpdateSourceTrigger=PropertyChanged}" Width="80" HorizontalAlignment="Left"
                                 FontFamily="{StaticResource Mono}" FontSize="12"/>
                        <TextBlock Text="TOLERÂNCIA" Style="{StaticResource SectionLabel}" Margin="0,14,0,8"/>
                        <WrapPanel>
                            <RadioButton Style="{StaticResource Pill}" Content="1 hora" IsChecked="{Binding GraceMinutes, Converter={StaticResource Equals}, ConverterParameter=60}"/>
                            <RadioButton Style="{StaticResource Pill}" Content="2 horas" IsChecked="{Binding GraceMinutes, Converter={StaticResource Equals}, ConverterParameter=120}"/>
                            <RadioButton Style="{StaticResource Pill}" Content="3 horas" IsChecked="{Binding GraceMinutes, Converter={StaticResource Equals}, ConverterParameter=180}"/>
                            <RadioButton Style="{StaticResource Pill}" Content="6 horas" IsChecked="{Binding GraceMinutes, Converter={StaticResource Equals}, ConverterParameter=360}"/>
                        </WrapPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="RETENÇÃO NO GOOGLE DRIVE" Style="{StaticResource SectionLabel}"/>
                    <CheckBox Content="Nunca apagar" Style="{StaticResource Switch}" IsChecked="{Binding NeverDelete}"/>
                    <StackPanel IsEnabled="{Binding NeverDelete, Converter={StaticResource InverseBool}}" Margin="0,12,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="30"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Manter por (dias)" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding RetentionDays, UpdateSourceTrigger=PropertyChanged}" Width="90" HorizontalAlignment="Left"
                                         FontFamily="{StaticResource Mono}" FontSize="12"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Sempre manter os últimos" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding MinBackupsToKeep, UpdateSourceTrigger=PropertyChanged}" Width="90" HorizontalAlignment="Left"
                                         FontFamily="{StaticResource Mono}" FontSize="12"/>
                            </StackPanel>
                        </Grid>
                        <WrapPanel Margin="0,10,0,0">
                            <RadioButton Style="{StaticResource Pill}" Content="7 dias" IsChecked="{Binding RetentionDays, Converter={StaticResource Equals}, ConverterParameter=7}"/>
                            <RadioButton Style="{StaticResource Pill}" Content="15 dias" IsChecked="{Binding RetentionDays, Converter={StaticResource Equals}, ConverterParameter=15}"/>
                            <RadioButton Style="{StaticResource Pill}" Content="30 dias" IsChecked="{Binding RetentionDays, Converter={StaticResource Equals}, ConverterParameter=30}"/>
                            <RadioButton Style="{StaticResource Pill}" Content="90 dias" IsChecked="{Binding RetentionDays, Converter={StaticResource Equals}, ConverterParameter=90}"/>
                            <RadioButton Style="{StaticResource Pill}" Content="1 ano" IsChecked="{Binding RetentionDays, Converter={StaticResource Equals}, ConverterParameter=365}"/>
                        </WrapPanel>
                    </StackPanel>
                    <TextBlock Text="{Binding RetentionSummary}" Style="{StaticResource Hint}" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <Button Content="Remover tarefa" Style="{StaticResource DangerButton}" HorizontalAlignment="Left"
                    Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
        </StackPanel>
    </Grid>
</UserControl>
