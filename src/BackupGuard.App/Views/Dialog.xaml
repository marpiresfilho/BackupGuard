<Window x:Class="BackupGuard.App.Views.Dialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="440" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        FontFamily="Segoe UI" TextOptions.TextFormattingMode="Display">
    <Border Background="{StaticResource Bg}" BorderBrush="{StaticResource BorderStrong}" BorderThickness="1"
            CornerRadius="6" Margin="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.18"/>
        </Border.Effect>
        <StackPanel Margin="22,18,22,18">
            <TextBlock x:Name="TitleText" Style="{StaticResource CardTitle}" FontSize="15" Margin="0,0,0,8"
                       MouseLeftButtonDown="OnDrag"/>
            <TextBlock x:Name="MessageText" Style="{StaticResource Body}" Margin="0,0,0,12"/>

            <TextBox x:Name="InputBox" Visibility="Collapsed" Margin="0,0,0,10"/>
            <PasswordBox x:Name="PasswordInput" Visibility="Collapsed" Margin="0,0,0,8"/>
            <TextBlock x:Name="ConfirmLabel" Text="Repita para confirmar" Style="{StaticResource Hint}"
                       Visibility="Collapsed" Margin="0,0,0,4"/>
            <PasswordBox x:Name="PasswordConfirm" Visibility="Collapsed" Margin="0,0,0,10"/>

            <Grid x:Name="SecretPanel" Visibility="Collapsed" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="SecretText" IsReadOnly="True" FontFamily="{StaticResource Mono}" FontSize="13"/>
                <Button Grid.Column="1" Content="Copiar" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                        Click="OnCopy"/>
            </Grid>

            <TextBlock x:Name="ErrorText" Foreground="{StaticResource Danger}" FontSize="11.5" TextWrapping="Wrap"
                       Visibility="Collapsed" Margin="0,0,0,10"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
                <Button x:Name="CancelButton" Content="Cancelar" Style="{StaticResource SecondaryButton}"
                        IsCancel="True" Click="OnCancel"/>
                <Button x:Name="OkButton" Content="OK" Style="{StaticResource PrimaryButton}" Margin="0"
                        IsDefault="True" Click="OnOk"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
