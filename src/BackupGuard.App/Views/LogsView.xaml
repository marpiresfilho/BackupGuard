<UserControl x:Class="BackupGuard.App.Views.LogsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <Border Style="{StaticResource Card}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Abrir pasta" Style="{StaticResource SecondaryButton}" Command="{Binding OpenFolderCommand}"/>
                    <Button Content="Atualizar" Style="{StaticResource SecondaryButton}" Command="{Binding LoadCommand}" Margin="0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox Content="Atualizar sozinho" Style="{StaticResource Switch}" IsChecked="{Binding AutoRefresh}" FontSize="12"/>
                    <CheckBox Content="Só avisos e erros" Style="{StaticResource Switch}" IsChecked="{Binding OnlyProblems}" FontSize="12" Margin="20,0,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <Border Style="{StaticResource Card}" Padding="0">
            <StackPanel>
                <TextBlock Text="{Binding FileName}" Style="{StaticResource Hint}" Margin="14,10,14,6" FontFamily="{StaticResource Mono}"/>
                <TextBox x:Name="LogBox" Text="{Binding Text, Mode=OneWay}" IsReadOnly="True" FontFamily="{StaticResource Mono}" FontSize="11.5"
                         BorderThickness="0" Height="440" TextWrapping="NoWrap" VerticalContentAlignment="Top"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextChanged="OnTextChanged"/>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
