<UserControl x:Class="BackupGuard.App.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="Head" TargetType="TextBlock" BasedOn="{StaticResource SectionLabel}">
            <Setter Property="Margin" Value="0"/>
        </Style>
        <Style x:Key="Cell" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
    </UserControl.Resources>
    <StackPanel>
        <Border Style="{StaticResource Card}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE72C;" Command="{Binding ReloadCommand}" ToolTip="Atualizar"/>
                <WrapPanel VerticalAlignment="Center">
                    <RadioButton Style="{StaticResource Pill}" Content="Todos" Margin="0,0,6,0"
                                 IsChecked="{Binding Filter, Converter={StaticResource Equals}, ConverterParameter=all}"/>
                    <RadioButton Style="{StaticResource Pill}" Content="Enviados" Margin="0,0,6,0"
                                 IsChecked="{Binding Filter, Converter={StaticResource Equals}, ConverterParameter=ok}"/>
                    <RadioButton Style="{StaticResource Pill}" Content="Falhas" Margin="0,0,6,0"
                                 IsChecked="{Binding Filter, Converter={StaticResource Equals}, ConverterParameter=fail}"/>
                    <TextBlock Text="{Binding SummaryText}" Style="{StaticResource Body}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                </WrapPanel>
            </DockPanel>
        </Border>

        <Border Style="{StaticResource Card}" Padding="0">
            <StackPanel>
                <Grid Margin="16,12,16,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="80"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="DATA" Style="{StaticResource Head}"/>
                    <TextBlock Grid.Column="1" Text="EMPRESA" Style="{StaticResource Head}"/>
                    <TextBlock Grid.Column="2" Text="ARQUIVO" Style="{StaticResource Head}"/>
                    <TextBlock Grid.Column="3" Text="ORIGINAL → NUVEM" Style="{StaticResource Head}"/>
                    <TextBlock Grid.Column="4" Text="TEMPO" Style="{StaticResource Head}"/>
                    <TextBlock Grid.Column="5" Text="STATUS" Style="{StaticResource Head}"/>
                </Grid>
                <ItemsControl ItemsSource="{Binding Rows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Padding="16,8">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="170"/>
                                            <ColumnDefinition Width="70"/>
                                            <ColumnDefinition Width="80"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding When}" Style="{StaticResource Cell}" FontFamily="{StaticResource Mono}" FontSize="11.5"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Job}" Style="{StaticResource Cell}"/>
                                        <TextBlock Grid.Column="2" Text="{Binding File}" Style="{StaticResource Cell}" ToolTip="{Binding File}"/>
                                        <TextBlock Grid.Column="3" Text="{Binding Sizes}" Style="{StaticResource Cell}" FontFamily="{StaticResource Mono}" FontSize="11.5"/>
                                        <TextBlock Grid.Column="4" Text="{Binding Duration}" Style="{StaticResource Cell}" FontFamily="{StaticResource Mono}" FontSize="11.5"/>
                                        <Border Grid.Column="5" Style="{StaticResource LevelBadge}" Tag="{Binding Level}">
                                            <TextBlock Text="{Binding StatusText}"/>
                                        </Border>
                                    </Grid>
                                    <TextBlock Text="{Binding Error}" Foreground="{StaticResource Danger}" FontSize="11" TextWrapping="Wrap"
                                               Margin="0,4,0,0" Visibility="{Binding Error, Converter={StaticResource NullToVis}}"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
