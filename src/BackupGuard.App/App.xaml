<Application x:Class="BackupGuard.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:BackupGuard.App"
             xmlns:vm="clr-namespace:BackupGuard.App.ViewModels"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <local:EqualsConverter x:Key="Equals"/>
            <local:InverseBoolConverter x:Key="InverseBool"/>
            <local:InverseBoolToVisConverter x:Key="InverseBoolToVis"/>
            <local:NullToVisConverter x:Key="NullToVis"/>

            <!-- Selo colorido conforme o nível (Tag = HealthLevel) -->
            <Style x:Key="LevelBadge" TargetType="Border" BasedOn="{StaticResource Badge}">
                <Setter Property="Background" Value="{StaticResource SuccessBg}"/>
                <Setter Property="TextElement.Foreground" Value="{StaticResource Success}"/>
                <Setter Property="TextElement.FontSize" Value="11"/>
                <Setter Property="TextElement.FontWeight" Value="SemiBold"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="{x:Static vm:HealthLevel.Warning}">
                        <Setter Property="Background" Value="{StaticResource WarningBg}"/>
                        <Setter Property="TextElement.Foreground" Value="{StaticResource Warning}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="{x:Static vm:HealthLevel.Error}">
                        <Setter Property="Background" Value="{StaticResource DangerBg}"/>
                        <Setter Property="TextElement.Foreground" Value="{StaticResource Danger}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
